# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# Nothing here is a real secret — these are placeholders only.

# --- Generation backend -----------------------------------------------------
# Auto-detected: local if LOCAL_WORKER_URL set, else minimax if key set, else mock.
# GEN_BACKEND=local|minimax|mock
# LOCAL_WORKER_URL=http://<gpu-ip>:8189      # comma-separate for a multi-GPU pool
# WORKER_TOKEN=<shared secret with the GPU worker>
# HF_TOKEN=<huggingface token, for gated models like LTX-2.x>
# MINIMAX_API_KEY=<optional premium backend>

# --- Broadcast tuning --------------------------------------------------------
# PORT=4242
# VIDEO_DURATION_SEC=6
# GEN_INTERVAL_SEC=300        # idle cadence between auto clips
# DAILY_GEN_LIMIT=200         # hard spend guardrail
# AUCTION_WINDOW_SEC=45       # bidding window before the winner generates

# --- Pricing (see lib/pricing.js for the unit economics) ---------------------
# CREDITS_PER_SECOND=5
# CREDITS_PER_SECOND_AD=10
# UPLOAD_COST_CREDITS=100

# --- Payments ----------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# PUBLIC_URL=https://multiversecable.com

# --- Database ----------------------------------------------------------------
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service role key — server side only, never ship to a browser>
# DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres

# --- Optional: Claude writes the show concepts -------------------------------
# ANTHROPIC_API_KEY=
# CONCEPT_MODEL=claude-opus-5
# ADMIN_EMAILS=you@example.com

# FAL_MODEL=minimax/h3-max-turbo/image-to-video   # default; h3-max is 4x the price
