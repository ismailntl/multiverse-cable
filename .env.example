# --- Generation backend -----------------------------------------------------
# Auto-detected: local if LOCAL_WORKER_URL is set, else minimax if
# MINIMAX_API_KEY is set, else mock. Override explicitly with GEN_BACKEND.
# GEN_BACKEND=local|minimax|mock

# Self-hosted GPU worker (gpu-worker/ on an EC2 g6e instance) — the cheap path
# LOCAL_WORKER_URL=http://<gpu-instance-ip>:8189
# WORKER_TOKEN=change-me

# MiniMax H3 hosted API — premium/burst path (~$0.5-0.8 per 6s clip)
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-H3
# VIDEO_RESOLUTION=768P        # 768P | 2K

# --- Broadcast tuning --------------------------------------------------------
# PORT=4242
# VIDEO_DURATION_SEC=6         # 4-15
# GEN_INTERVAL_SEC=300         # one new clip every N seconds — THE cost dial
# DAILY_GEN_LIMIT=200          # hard spend guardrail
# MAX_LIBRARY_CLIPS=500

# --- Optional: Claude writes the show concepts -------------------------------
# ANTHROPIC_API_KEY=
# CONCEPT_MODEL=claude-opus-5
